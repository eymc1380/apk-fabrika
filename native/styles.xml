<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Normal Calisma Temasi -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <item name="colorPrimary">#0284c7</item>
        <item name="colorPrimaryDark">#0b0f19</item>
        <item name="colorAccent">#0284c7</item>
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <!-- Acilis (Splash) Temasi -->
    <style name="AppTheme.NoActionBarLaunch" parent="AppTheme">
        <item name="android:windowBackground">@drawable/launch_screen</item>
        <item name="android:statusBarColor">#0b0f19</item>
        <item name="android:navigationBarColor">#0b0f19</item>
    </style>
</resources>
